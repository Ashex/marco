#!/usr/bin/env bash
# The fork's checks before every commit: what CI runs (fmt, clippy) and the workspace tests.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# check what's being committed, not unstaged or untracked files beside it
if ! git diff --quiet || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
    git stash push --keep-index --include-untracked --quiet --message "pre-commit"
    trap 'git stash pop --quiet' EXIT
fi

step() { printf '\npre-commit: %s\n' "$*"; }

step "cargo fmt --check"
cargo fmt --check

step "cargo clippy"
cargo clippy --quiet --all-targets --locked -- -D warnings

step "cargo test (the Scylla tests stay ignored)"
cargo test --quiet --workspace --locked
